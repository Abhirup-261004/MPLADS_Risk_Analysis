NODE_ENV=production
PORT=5001
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/prahari-ai
JWT_SECRET=replace_with_a_unique_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.example
SEED_ADMIN_ON_START=false

# Keep false until the FastAPI service has a deployed URL.
FASTAPI_ENABLED=false
# FASTAPI_URL=https://your-fastapi-domain.example
